# Legacy dotenv compatibility example. New Profiles store credentials directly
# in methodology.yaml / notify.yaml; see config/README.md. No env is required.
#
# Copy this template outside Git (for example to .local/credentials/hypoloom.env;
# /.local/ is Git-ignored), keep the directory mode 0700 and the file mode
# 0600, and fill in only the values you use. Reference the file by absolute
# path from notify.yaml (sinks.telegram.credentials_file) and methodology.yaml
# (literature.credentials_file). Never commit a filled copy.
#
# Strict subset: KEY=VALUE lines and # comments; no quoting, export or expansion.

# Telegram bot delivery (notify.yaml sinks.telegram; TELEGRAM_BOT_TOKEN format 123456:ABC...):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Literature adapters (methodology.yaml literature; the operator flow passes
# the file to the Host as --credentials-file):
OPENALEX_API_KEY=
# Optional for the Semantic Scholar DOI-to-OA-PDF fallback; blank stays anonymous.
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=

# Optional managed notification variables. Select this existing file with
# --notification-credentials-file; match *_env references in notify.yaml.
# HYPOLOOM_WEBHOOK_URL=https://your-approved-receiver.example/events
# HYPOLOOM_WEBHOOK_TOKEN=
# HYPOLOOM_NOTIFICATION_PROXY=http://127.0.0.1:7890
