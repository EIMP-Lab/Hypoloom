include LICENSE README.md README.zh-CN.md SETUP.md SETUP.zh-CN.md USAGE.md USAGE.zh-CN.md CONTRIBUTING.md CONTRIBUTING.zh-CN.md AGENTS.md CLAUDE.md
include docs/assets/hypoloom_vector.svg docs/assets/hypoloom_overview.svg
include environment.yml .gitignore .gitattributes
include .github/ISSUE_TEMPLATE/bug_report.yml
include .claude/settings.example.json
include .claude/hooks/dispatch.py .claude/hooks/guard_paths.py
recursive-include .claude/skills/autoresearch *.md *.py
recursive-include docs *.md
include profiles/README.md
recursive-include profiles/templates *.yaml
recursive-include tests *.py *.yaml *.md *.txt
include scripts/qualify.py
global-exclude __pycache__ *.py[cod]
